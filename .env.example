# ============================================================
# Painel Maquina de Sites Internacional
# Copie este arquivo para .env.local (local) ou cole na Vercel (Settings > Environment Variables).
# Variaveis NEXT_PUBLIC_* vao para o navegador; as demais ficam so no servidor.
# ============================================================

# ---------- Supabase (obrigatorio) ----------
# Supabase > Project Settings > API. A chave anon e publica por design; os dados sao protegidos por RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usuario do painel criado em Supabase > Authentication > Users.
# Usado pelas rotas /api/* (server-side) para ler e gravar no schema maquina_sites.
PAINEL_EMAIL=
PAINEL_PW=

# ---------- Marca ----------
# Nome da sua agencia. Aparece na area do cliente (/c/{token}) e nos alertas do Telegram.
NEXT_PUBLIC_MARCA=
# Email de contato mostrado no rodape da area do cliente. Vazio = nao aparece.
NEXT_PUBLIC_EMAIL_CONTATO=
# Frase curta abaixo da marca no rodape. Padrao: "Web Agency".
NEXT_PUBLIC_TAGLINE=
# URL publica do painel (sem barra no final). Usada para montar o link da area do cliente.
# Vazio = usa o dominio atual do navegador.
NEXT_PUBLIC_PAINEL_URL=

# ---------- Precos por pais (numeros, sem simbolo) ----------
# Se vazio, usa os padroes: DE 499/39, UK 299/29, UKH 599/49, BR 2500/199.
NEXT_PUBLIC_PRECO_DE_UNICA=
NEXT_PUBLIC_PRECO_DE_MENSAL=
NEXT_PUBLIC_PRECO_UK_UNICA=
NEXT_PUBLIC_PRECO_UK_MENSAL=
NEXT_PUBLIC_PRECO_UKH_UNICA=
NEXT_PUBLIC_PRECO_UKH_MENSAL=
NEXT_PUBLIC_PRECO_BR_UNICA=
NEXT_PUBLIC_PRECO_BR_MENSAL=

# ---------- Links de checkout por pais ----------
# Crie os produtos no seu provedor (Dodo Payments, Lemon Squeezy, Stripe Payment Links, Kiwify etc)
# e cole o link de compra aqui. Vazio = o botao de pagamento nao aparece para aquele pais.
NEXT_PUBLIC_CHECKOUT_DE_UNICA=
NEXT_PUBLIC_CHECKOUT_DE_MENSAL=
NEXT_PUBLIC_CHECKOUT_UK_UNICA=
NEXT_PUBLIC_CHECKOUT_UK_MENSAL=
NEXT_PUBLIC_CHECKOUT_UKH_UNICA=
NEXT_PUBLIC_CHECKOUT_UKH_MENSAL=
NEXT_PUBLIC_CHECKOUT_BR_UNICA=
NEXT_PUBLIC_CHECKOUT_BR_MENSAL=

# ---------- Telegram (opcional) ----------
# Alertas de nova solicitacao e pedido de cancelamento.
# Token: crie um bot com o @BotFather. Chat ID: envie uma mensagem ao bot e consulte
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Exclusao de lead (opcional) ----------
# A rota /api/excluir-lead apaga o projeto na Vercel e o repositorio no GitHub do site construido.
# Vercel > Settings > Tokens. Team ID em Vercel > Team Settings > General.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# GitHub > Settings > Developer settings > Personal access tokens (escopo delete_repo).
GITHUB_TOKEN=
# Usuario ou organizacao do GitHub onde os sites sao criados.
GITHUB_ORG=
